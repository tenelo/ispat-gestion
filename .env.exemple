# =====================================================================================
#  ISPAT Gestion — paramètres du serveur
#  Copier en « .env » (cp .env.exemple .env), remplir, puis : chmod 600 .env
#  Générer chaque secret avec :  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
# =====================================================================================

# Domaine de l'application (sans https://). L'enregistrement DNS A doit pointer vers le VPS.
DOMAINE=gestion.ispat.tenelo.cloud

# Port local sur lequel le Nginx du serveur relaie le domaine (libre sur le VPS).
PORT_WEB=8090

# --- Base PostgreSQL -----------------------------------------------------------------
DB_NAME=ispat_gestion
DB_USER=ispat
DB_PASSWORD=
# Mot de passe du super-utilisateur « postgres » du conteneur (création de la base uniquement).
DB_SUPERUSER_PASSWORD=

# --- Django ----------------------------------------------------------------------------
DJANGO_SECRET_KEY=

# --- Liaison avec le site WordPress (pré-inscriptions en ligne) ---------------------------
# Même valeur que ISPAT_API_SECRET dans le wp-config.php du site. Vide = liaison désactivée.
ISPAT_WP_SECRET=
# Facultatif : IP publique du serveur WordPress (sécurité supplémentaire).
ISPAT_WP_IPS=

# --- Réglages ----------------------------------------------------------------------------
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
GUNICORN_WORKERS=3

# --- Sauvegardes (scripts/sauvegarde.sh) -------------------------------------------------
DOSSIER_SAUVEGARDES=/root/sauvegardes/ispat-gestion
JOURS_CONSERVATION=14
