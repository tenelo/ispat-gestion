# Copier ce fichier en .env et renseigner les valeurs
DJANGO_SECRET_KEY=changer-moi-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (schéma ispat déjà créé avec ispat_gestion_schema.sql)
DB_NAME=ispat_gestion
DB_USER=ispat
DB_PASSWORD=changer-moi
DB_HOST=127.0.0.1
DB_PORT=5432

# Front Angular autorisé (séparés par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Dossier des fichiers (photos, pièces jointes) — hors du dossier du code en production
# MEDIA_ROOT=/var/lib/ispat/media

# Logo des bulletins (par défaut : ressources/logo_ispat.png)
# ISPAT_LOGO=/var/lib/ispat/logo_ispat.png

# Liaison avec le site WordPress : secret partagé (identique à ISPAT_API_SECRET dans wp-config.php)
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
ISPAT_WP_SECRET=
# Facultatif : IP du serveur WordPress (séparées par des virgules) ; True si l'API est derrière Nginx
# ISPAT_WP_IPS=
# ISPAT_DERRIERE_PROXY=True

# Durées des jetons JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
