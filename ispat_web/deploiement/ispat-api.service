# systemd — API ISPAT Gestion (Gunicorn). À copier dans /etc/systemd/system/ispat-api.service puis :
#   systemctl daemon-reload && systemctl enable --now ispat-api
[Unit]
Description=ISPAT Gestion - API Django
After=network.target postgresql.service

[Service]
User=ispat
Group=www-data
WorkingDirectory=/opt/ispat/ispat_api
ExecStart=/opt/ispat/ispat_api/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
